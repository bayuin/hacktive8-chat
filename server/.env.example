# ==============================================================================
# WanderWise AI - Express REST API Environment Configuration
# ==============================================================================
# Port server Express
PORT=3000

# Google Gemini API Key
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (e.g. gemini-2.0-flash, gemini-2.5-flash-lite, gemini-1.5-flash)
DEFAULT_MODEL=gemini-2.0-flash
